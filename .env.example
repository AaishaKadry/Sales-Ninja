# Local development can use SQLite. For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://salesninja:password@localhost:5432/salesninja
DATABASE_URL=sqlite:///./sales_ninja.db

# AWS Bedrock
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Optional named AWS CLI profile. Leave blank to use the standard AWS credential chain.
AWS_PROFILE=

# Frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10

# Frontend only (set in frontend/.env.local if API is hosted elsewhere)
# VITE_API_URL=http://localhost:8000
